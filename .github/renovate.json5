{
    enabledManagers: [
        "custom.regex",
        "github-actions",
    ],
    customManagers: [
        {   // manage the uv version in the entrypoint
            customType: "regex",
            managerFilePatterns: ["/^\\.github/renovate-entrypoint\\.sh$/"],
            matchStrings: [
              "# renovate:(?: datasource=(?<datasource>[a-z-.]+?))?(?: depName=(?<depName>[^\\s]+?))(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: depType=(?<depType>[^\\s]+?))?\\s+install-tool\\s+(?<packageName>[^\\s]+?)\\s+(?<currentValue>[0-9.]+?)\\s",
            ],
            datasourceTemplate: "pypi",
            depTypeTemplate: "dev",
        },
    ],
}
